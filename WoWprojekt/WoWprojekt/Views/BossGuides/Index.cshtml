@model WoWprojekt.Models.ViewModels.BossGuideIndexViewModel
@{
    ViewData["Title"] = "Bosses";
}

<div class="crud-header">
    <h1 class="content-header">Boss Archives</h1>
    <a class="btn-primary" asp-action="Create">Add</a>
</div>

<div class="crud-toolbar">
    <label class="search-label" for="boss-search">Search encounters</label>
    <div class="crud-search">
        <div class="autocomplete-search">
            <input id="boss-search"
                   class="search-input autocomplete-input"
                   type="search"
                   placeholder="Search bosses or raids"
                   value="@Model.SearchQuery"
                   data-suggest-url="@Url.Action("Suggest")"
                   data-preview-count="4"
                   autocomplete="off"
                   spellcheck="false"
                   aria-expanded="false" />
            <div class="autocomplete-panel" role="listbox" aria-hidden="true">
                <div class="autocomplete-status is-hidden" data-autocomplete-status></div>
                <ul class="autocomplete-results" data-autocomplete-results></ul>
                <button class="autocomplete-more is-hidden" type="button" data-autocomplete-more>Show more</button>
            </div>
        </div>
        <button id="boss-search-btn" class="search-button" type="button">Search</button>
    </div>
</div>

<div id="boss-list" class="crud-list-container">
    @await Html.PartialAsync("_BossGuideList", Model)
</div>

@section Scripts {
    <script>
        (() => {   
            const input = document.getElementById("boss-search");
            const button = document.getElementById("boss-search-btn");
            const list = document.getElementById("boss-list");
            const endpoint = "@Url.Action("Search")";

            if (!input || !button || !list || !endpoint) {
                return;
            }

            const runSearch = () => {
                const query = encodeURIComponent(input.value || "");
                list.classList.add("is-loading");

                fetch(`${endpoint}?q=${query}`, { headers: { "X-Requested-With": "XMLHttpRequest" } })
                    .then((response) => response.text())
                    .then((html) => {
                        list.innerHTML = html;
                    })
                    .catch(() => {})
                    .finally(() => {
                        list.classList.remove("is-loading");
                    });
            };

            button.addEventListener("click", runSearch);
            input.addEventListener("keydown", (event) => {
                if (event.key === "Enter") {
                    event.preventDefault();
                    runSearch();
                }
            });

            let debounceTimer = null;
            input.addEventListener("input", () => {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(runSearch, 220);
            });
        })();
    </script>
}
