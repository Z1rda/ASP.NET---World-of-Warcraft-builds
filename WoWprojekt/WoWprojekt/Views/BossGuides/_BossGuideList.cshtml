@model WoWprojekt.Models.ViewModels.BossGuideIndexViewModel

@if (!Model.Bosses.Any())
{
    <p class="empty-state">No boss guides found.</p>
}
else
{
    <div class="crud-list">
        @foreach (var boss in Model.Bosses)
        {
            var raidName = boss.RaidGuide?.RaidName ?? "Unknown raid";
            <div class="crud-list-item">
                <div class="crud-item-main">
                    <h2 class="entity-title">@boss.BossName</h2>
                    <p class="crud-meta">Raid: @raidName | Difficulty @boss.DifficultyRating/10</p>
                </div>
                <div class="crud-actions">
                    <a class="btn-ghost" asp-action="Details" asp-route-id="@boss.Id">Details</a>
                    @if (User.IsInRole("admin") || User.IsInRole("moderator"))
                    {
                        <a class="btn-ghost" asp-action="Edit" asp-route-id="@boss.Id">Edit</a>
                        <a class="btn-danger" asp-action="Delete" asp-route-id="@boss.Id">Delete</a>

                    }
                </div>
            </div>
        }
    </div>
}
