@model WoWprojekt.Models.BossGuide
@{
    ViewData["Title"] = "Boss Details";
}

<h1 class="content-header">Boss Guide Details</h1>

<div class="detail-block">
    <h3>Encounter</h3>
    <p>Name: @Model.BossName</p>
    <p>Raid: @(Model.RaidGuide?.RaidName ?? "Unknown")</p>
    <p>Difficulty: @Model.DifficultyRating/10</p>
</div>

@{
    var placeholderUrl = $"https://placehold.co/96x96/1c1f24/e6dec6?text={Uri.EscapeDataString(Model.BossName)}";
}
<div class="detail-block boss-detail-media">
    <img class="boss-detail-image"
         src="@(string.IsNullOrWhiteSpace(Model.BossImageUrl) ? placeholderUrl : Model.BossImageUrl)"
         alt="@Model.BossName"
         onerror="this.src='@placeholderUrl'; this.onerror=null;" />
</div>

<div class="detail-block">
    <h3>Tactics</h3>
    <p>@Model.Tactics</p>
</div>

<div class="detail-block">
    <h3>Images</h3>
    <div id="bossImagesList" style="display:flex; gap:8px; flex-wrap:wrap; margin-top:8px;"></div>
</div>

<div class="detail-block raid-animator" data-raid-animator data-boss="@Model.BossName">
    <div class="raid-animator-header">
        <div>
            <h3>Raid Positioning</h3>
            <p class="raid-animator-note">Select a phase to preview repositioning.</p>
        </div>
        <div class="raid-phase-controls" role="group" aria-label="Raid phase">
            <button class="phase-button is-active" type="button" data-phase="phase1">Phase I</button>
            <button class="phase-button" type="button" data-phase="phase2">Phase II</button>
            <button class="phase-button" type="button" data-phase="phase3">Phase III</button>
        </div>
    </div>
    <div class="raid-arena" data-raid-arena>
        <div class="raid-frost-overlay" aria-hidden="true"></div>
        <div class="raid-marker role-tank" data-role="tank" data-index="0"><span>T</span></div>
        <div class="raid-marker role-tank" data-role="tank" data-index="1"><span>T</span></div>

        <div class="raid-marker role-healer" data-role="healer" data-index="0"><span>H</span></div>
        <div class="raid-marker role-healer" data-role="healer" data-index="1"><span>H</span></div>
        <div class="raid-marker role-healer" data-role="healer" data-index="2"><span>H</span></div>
        <div class="raid-marker role-healer" data-role="healer" data-index="3"><span>H</span></div>

        <div class="raid-marker role-dps" data-role="dps" data-index="0"><span>D</span></div>
        <div class="raid-marker role-dps" data-role="dps" data-index="1"><span>D</span></div>
        <div class="raid-marker role-dps" data-role="dps" data-index="2"><span>D</span></div>
        <div class="raid-marker role-dps" data-role="dps" data-index="3"><span>D</span></div>
        <div class="raid-marker role-dps" data-role="dps" data-index="4"><span>D</span></div>
        <div class="raid-marker role-dps" data-role="dps" data-index="5"><span>D</span></div>
    </div>
    <div class="raid-legend" aria-hidden="true">
        <span class="legend-item role-tank">Tank</span>
        <span class="legend-item role-healer">Healer</span>
        <span class="legend-item role-dps">DPS</span>
    </div>
</div>

@if (User.IsInRole("admin"))
{
    <a class="btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
}
<a class="btn-ghost" asp-action="Index">Back</a>

@section Scripts {
    <script>
        const isAdmin = @(User.IsInRole("admin") ? "true" : "false");

        document.addEventListener('DOMContentLoaded', async function () {
            const list = document.getElementById('bossImagesList');
            const resp = await fetch(`/api/bosses/@Model.Id/images`);
            if (!resp.ok) return;
            const items = await resp.json();
            for (const img of items) {
                const wrapper = document.createElement('div');
                wrapper.style.width = '120px';
                wrapper.style.textAlign = 'center';

                const thumb = document.createElement('img');
                thumb.src = img.fileUrl || img.FileUrl;
                thumb.alt = img.originalFileName || img.OriginalFileName || '';
                thumb.style.width = '100%';
                thumb.style.height = 'auto';
                wrapper.appendChild(thumb);

                if (isAdmin) {
                    const del = document.createElement('button');
                    del.textContent = 'Delete';
                    del.className = 'btn-ghost';
                    del.style.display = 'block';
                    del.style.marginTop = '6px';
                    del.onclick = async () => {
                        if (!confirm('Delete this image?')) return;
                        const r = await fetch(`/api/bosses/@Model.Id/images/${img.id || img.Id}`, { method: 'DELETE' });
                        if (r.ok) location.reload();
                        else alert('Delete failed');
                    };
                    wrapper.appendChild(del);
                }

                list.appendChild(wrapper);
            }
        });
    </script>
}