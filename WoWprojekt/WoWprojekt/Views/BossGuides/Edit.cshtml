@model WoWprojekt.Models.BossGuide
@{
    ViewData["Title"] = "Edit Boss";
}

<h1 class="content-header">Edit Boss Guide</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="detail-block" asp-validation-summary="ModelOnly"></div>

    <div class="detail-block">
        <label asp-for="BossName"></label>
        <input asp-for="BossName" class="search-input" />
        <span asp-validation-for="BossName"></span>
    </div>

    <div class="detail-block">
        <label asp-for="BossImageUrl"></label>
        <input asp-for="BossImageUrl" class="search-input" />
        <span asp-validation-for="BossImageUrl"></span>
    </div>

    <div class="detail-block">
        @{
            var raidOptions = ViewData["RaidGuideId"] as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
            var selectedRaidName = raidOptions?.FirstOrDefault(option => option.Value == Model.RaidGuideId.ToString())?.Text;
        }
        <partial name="_AutocompleteSelect" view-data="@(new ViewDataDictionary(ViewData)
        {
            { "Name", "RaidGuideId" },
            { "Label", "Raid" },
            { "Url", "/Raids/Search" },
            { "Placeholder", "Search raids..." },
            { "SelectedId", Model.RaidGuideId },
            { "SelectedText", selectedRaidName ?? string.Empty },
            { "InputId", "RaidGuideId_autocomplete" }
        })" />
        <span asp-validation-for="RaidGuideId"></span>
    </div>

    <div class="detail-block">
        <label asp-for="DifficultyRating"></label>
        <input asp-for="DifficultyRating" class="search-input" />
        <span asp-validation-for="DifficultyRating"></span>
    </div>

    <div class="detail-block">
        <label asp-for="Tactics"></label>
        <textarea asp-for="Tactics" class="search-input" rows="6"></textarea>
        <span asp-validation-for="Tactics"></span>
    </div>

    <button class="btn-primary" type="submit">Save</button>
    <a class="btn-ghost" asp-action="Index">Back</a>
</form>

@if (User.IsInRole("admin"))
{
    <div style="margin-top:12px;">
        <form id="simpleUploadForm" method="post" action="/api/bosses/@Model.Id/images" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <label for="simpleUpload">Add image (JPG/PNG):</label>
            <input type="file" id="simpleUpload" name="file" accept=".jpg,.jpeg,.png" />
            <button type="submit" class="btn-primary">Upload</button>
        </form>
    </div>

    <h2 class="content-header">Boss Images (Gallery)</h2>

    <div id="boss-images-section">
        <form id="bossDropzone" class="dropzone" enctype="multipart/form-data">
            <div class="dz-message">Drop images here or click to upload (JPG, PNG)</div>
        </form>

        <div id="bossImagesList" style="margin-top:12px; display:flex; gap:8px; flex-wrap:wrap;"></div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.9.3/min/dropzone.min.js" integrity="sha512-8g7w3kqYyqJ3q3Hq2X9fD0k3a6x6Y1vQ3Vq2QY5sK1yP7bqv8nM1r1g1Z8T+6sE9GqTz1G9Q==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/dropzone/5.9.3/min/dropzone.min.css" integrity="sha512-+R0m3kGk0zQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <script>
        Dropzone.autoDiscover = false;

        async function refreshBossImages() {
            const list = document.getElementById('bossImagesList');
            list.innerHTML = '';
            const resp = await fetch(`/api/bosses/${Model.Id}/images`);
            if (!resp.ok) return;
            const items = await resp.json();
            for (const img of items) {
                const wrapper = document.createElement('div');
                wrapper.style.width = '120px';
                wrapper.style.textAlign = 'center';

                const thumb = document.createElement('img');
                thumb.src = img.fileUrl || img.FileUrl || img.FileUrl;
                thumb.style.width = '100%';
                thumb.style.height = 'auto';
                thumb.alt = img.originalFileName || img.OriginalFileName;

                wrapper.appendChild(thumb);

                {
                    const del = document.createElement('button');
                    del.textContent = 'Delete';
                    del.className = 'btn-ghost';
                    del.style.display = 'block';
                    del.style.marginTop = '6px';
                    del.onclick = async () => {
                        if (!confirm('Delete this image?')) return;
                        const r = await fetch(`/api/bosses/${Model.Id}/images/${img.id || img.Id}`, { method: 'DELETE' });
                        if (r.ok) await refreshBossImages();
                        else alert('Delete failed');
                    };
                    wrapper.appendChild(del);
                }

                list.appendChild(wrapper);
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            if (!document.getElementById('bossDropzone')) return;

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';

            const dz = new Dropzone('#bossDropzone', {
                url: `/api/bosses/${Model.Id}/images`,
                paramName: 'file',
                maxFilesize: 5,
                acceptedFiles: '.jpg,.jpeg,.png',
                headers: {
                    'RequestVerificationToken': token
                }
            });

            dz.on('success', function () { refreshBossImages(); });
            dz.on('error', function () { alert('Upload failed'); });

            refreshBossImages();
        });
        // Intercept simple fallback form submit and send via fetch to avoid navigation
        (function () {
            const form = document.getElementById('simpleUploadForm');
            if (!form) return;
            form.addEventListener('submit', async function (e) {
                e.preventDefault();
                const input = form.querySelector('input[type=file]');
                if (!input || input.files.length === 0) {
                    alert('Please select a file');
                    return;
                }

                const fd = new FormData();
                fd.append('file', input.files[0]);

                // include antiforgery token if present
                const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
                const headers = {};
                if (tokenInput) headers['RequestVerificationToken'] = tokenInput.value;

                try {
                    const resp = await fetch(form.action, {
                        method: 'POST',
                        body: fd,
                        credentials: 'same-origin',
                        headers
                    });
                    if (resp.ok) {
                        await refreshBossImages();
                        form.reset();
                        alert('Upload successful');
                    } else {
                        const txt = await resp.text();
                        alert('Upload failed: ' + (txt || resp.statusText));
                    }
                } catch (err) {
                    alert('Upload error: ' + err);
                }
            });
        })();
    </script>
}
