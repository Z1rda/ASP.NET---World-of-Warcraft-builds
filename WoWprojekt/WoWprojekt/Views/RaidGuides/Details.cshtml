@model WoWprojekt.Models.RaidGuide
@{
    ViewData["Title"] = "Raid Details";
}

<h1 class="content-header">Raid Guide Details</h1>

<div class="detail-block">
    <h3>Overview</h3>
    <p>Name: @Model.RaidName</p>
    <p>Updated: @Model.UpdatedAt.ToString("yyyy-MM-dd")</p>
</div>

<div class="detail-block">
    <h3>Preparation Notes</h3>
    <p>@Model.PreparationNotes</p>
</div>

<div class="detail-block">
    <h3>Bosses</h3>
    @if (Model.Bosses.Any())
    {
        <ul>
            @foreach (var boss in Model.Bosses)
            {
                <li>@boss.BossName (Difficulty @boss.DifficultyRating/10)</li>
            }
        </ul>
    }
    else
    {
        <p class="empty-state">No bosses linked.</p>
    }
</div>

<a class="btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
<a class="btn-ghost" asp-action="Index">Back</a>
