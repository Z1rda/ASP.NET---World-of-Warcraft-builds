@model WoWprojekt.Models.RaidGuide
@{
    ViewData["Title"] = "Create Raid";
}

<h1 class="content-header">Create Raid Guide</h1>

<form asp-action="Create" method="post">
    <div class="detail-block" asp-validation-summary="ModelOnly"></div>

    <div class="detail-block">
        <label asp-for="RaidName"></label>
        <input asp-for="RaidName" class="search-input" />
        <span asp-validation-for="RaidName"></span>
    </div>

    <div class="detail-block">
        <label asp-for="PreparationNotes"></label>
        <textarea asp-for="PreparationNotes" class="search-input" rows="6"></textarea>
        <span asp-validation-for="PreparationNotes"></span>
    </div>

    <button class="btn-primary" type="submit">Save</button>
    <a class="btn-ghost" asp-action="Index">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
