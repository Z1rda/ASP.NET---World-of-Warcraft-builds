@model WoWprojekt.Models.ViewModels.PlayerProfileIndexViewModel

@if (!Model.Players.Any())
{
    <p class="empty-state">No player profiles found.</p>
}
else
{
    <div class="crud-list">
        @foreach (var player in Model.Players)
        {
            var guildName = player.Guild?.Name ?? "No guild";
            <div class="crud-list-item">
                <div class="crud-item-main">
                    <h2 class="entity-title">@player.CharacterName</h2>
                    <p class="crud-meta">Class: @player.ClassType | Level @player.Level | @guildName</p>
                </div>
                <div class="crud-actions">
                    <a class="btn-ghost" asp-action="Details" asp-route-id="@player.Id">Details</a>
                    @if (User.IsInRole("admin") || User.IsInRole("moderator"))
                    {
                        <a class="btn-ghost" asp-action="Edit" asp-route-id="@player.Id">Edit</a>
                    
                        <a class="btn-danger" asp-action="Delete" asp-route-id="@player.Id">Delete</a>
                    }
                </div>
            </div>
        }
    </div>
}
