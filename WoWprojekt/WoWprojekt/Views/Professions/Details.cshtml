@model WoWprojekt.Models.Profession
@{
    ViewData["Title"] = "Profession Details";
}

<h1 class="content-header">Profession Details</h1>

<div class="detail-block">
    <h3>Overview</h3>
    <p>Name: @Model.Name</p>
    <p>Benefit: @Model.BenefitDescription</p>
</div>

<div class="detail-block">
    <h3>Players</h3>
    @if (Model.Players.Any())
    {
        <ul>
            @foreach (var link in Model.Players)
            {
                <li>@(link.PlayerProfile?.CharacterName ?? "Unknown") (Skill @link.SkillLevel)</li>
            }
        </ul>
    }
    else
    {
        <p class="empty-state">No players linked.</p>
    }
</div>

<a class="btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
<a class="btn-ghost" asp-action="Index">Back</a>
