@model WoWprojekt.Models.Profession
@{
    ViewData["Title"] = "Create Profession";
}

<h1 class="content-header">Create Profession</h1>

<form asp-action="Create" method="post">
    <div class="detail-block" asp-validation-summary="ModelOnly"></div>

    <div class="detail-block">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="search-input" />
        <span asp-validation-for="Name"></span>
    </div>

    <div class="detail-block">
        <label asp-for="BenefitDescription"></label>
        <textarea asp-for="BenefitDescription" class="search-input" rows="4"></textarea>
        <span asp-validation-for="BenefitDescription"></span>
    </div>

    <button class="btn-primary" type="submit">Save</button>
    <a class="btn-ghost" asp-action="Index">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
