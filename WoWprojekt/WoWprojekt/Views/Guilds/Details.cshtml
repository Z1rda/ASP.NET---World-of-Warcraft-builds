@model WoWprojekt.Models.Guild
@{
    ViewData["Title"] = "Guild Details";
}

<h1 class="content-header">Guild Details</h1>

<div class="detail-block">
    <h3>Registry</h3>
    <p>Name: @Model.Name</p>
    <p>Realm: @Model.Realm</p>
    <p>Created: @Model.CreatedAt.ToString("yyyy-MM-dd")</p>
    <p>Members: @Model.Members.Count</p>
</div>

<div class="detail-block">
    <h3>Roster</h3>
    @if (Model.Members.Any())
    {
        <ul>
            @foreach (var member in Model.Members)
            {
                <li>@member.CharacterName (@member.ClassType) - Level @member.Level</li>
            }
        </ul>
    }
    else
    {
        <p class="empty-state">No members linked.</p>
    }
</div>

@if (User.IsInRole("admin"))
{
    <a class="btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
}
<a class="btn-ghost" asp-action="Index">Back</a>
