@model WoWprojekt.Models.ViewModels.GuildIndexViewModel

@if (!Model.Guilds.Any())
{
    <p class="empty-state">No guilds found.</p>
}
else
{
    <div class="crud-list">
        @foreach (var guild in Model.Guilds)
        {
            <div class="crud-list-item">
                <div class="crud-item-main">
                    <h2 class="entity-title">@guild.Name</h2>
                    <p class="crud-meta">Realm: @guild.Realm | Members: @guild.Members.Count</p>
                </div>
                <div class="crud-actions">
                    <a class="btn-ghost" asp-action="Details" asp-route-id="@guild.Id">Details</a>
                    <a class="btn-ghost" asp-action="Edit" asp-route-id="@guild.Id">Edit</a>
                    <form class="inline-form" asp-action="Delete" asp-route-id="@guild.Id" method="post">
                        <button class="btn-danger" type="submit">Delete</button>
                    </form>
                </div>
            </div>
        }
    </div>
}
