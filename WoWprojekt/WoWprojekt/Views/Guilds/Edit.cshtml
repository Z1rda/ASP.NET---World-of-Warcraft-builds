@model WoWprojekt.Models.Guild
@{
    ViewData["Title"] = "Edit Guild";
}

<h1 class="content-header">Edit Guild</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="detail-block" asp-validation-summary="ModelOnly"></div>

    <div class="detail-block">
        <label asp-for="Name"></label>
        <input asp-for="Name" class="search-input" />
        <span asp-validation-for="Name"></span>
    </div>

    <div class="detail-block">
        <label asp-for="Realm"></label>
        <input asp-for="Realm" class="search-input" />
        <span asp-validation-for="Realm"></span>
    </div>

    <partial name="_DateTimeControl" view-data="@(new ViewDataDictionary(ViewData)
    {
        { "Name", nameof(Model.CreatedAt) },
        { "Label", "Created At" },
        { "Value", Model.CreatedAt },
        { "InputId", "CreatedAt_picker" }
    })" />

    <button class="btn-primary" type="submit">Save</button>
    <a class="btn-ghost" asp-action="Index">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
