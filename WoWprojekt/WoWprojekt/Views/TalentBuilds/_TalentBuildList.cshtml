@model WoWprojekt.Models.ViewModels.TalentBuildIndexViewModel

@if (!Model.TalentBuilds.Any())
{
    <p class="empty-state">No talent builds found.</p>
}
else
{
    <div class="crud-list">
        @foreach (var build in Model.TalentBuilds)
        {
            var owner = build.PlayerProfile?.CharacterName ?? "Unassigned";
            <div class="crud-list-item">
                <div class="crud-item-main">
                    <h2 class="entity-title">@build.BuildName</h2>
                    <p class="crud-meta">Code: @build.TalentCode | @owner</p>
                </div>
                <div class="crud-actions">
                    <a class="btn-ghost" asp-action="Details" asp-route-id="@build.Id">Details</a>
                    @if (User.IsInRole("admin") || User.IsInRole("moderator"))
                    {
                        <a class="btn-ghost" asp-action="Edit" asp-route-id="@build.Id">Edit</a>
                        <form class="inline-form" asp-action="Delete" asp-route-id="@build.Id" method="post">
                            <button class="btn-danger" type="submit">Delete</button>
                        </form>
                    }
                </div>
            </div>
        }
    </div>
}
