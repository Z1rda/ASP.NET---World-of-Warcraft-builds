@model WoWprojekt.Models.TalentBuild
@{
    ViewData["Title"] = "Delete Talent Build";
}

<h1 class="content-header">Delete Talent Build</h1>

<p class="content-subtitle">Confirm removal of this talent build.</p>

<div class="detail-block">
    <p>Name: @Model.BuildName</p>
    <p>Player: @(Model.PlayerProfile?.CharacterName ?? "Unknown")</p>
    <p>Published: @Model.PublishedAt.ToString("yyyy-MM-dd")</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button class="btn-danger" type="submit">Delete</button>
    <a class="btn-ghost" asp-action="Index">Back</a>
</form>
