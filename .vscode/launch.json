{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "WoWprojekt (Run)",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/WoWprojekt/WoWprojekt/bin/Debug/net10.0/WoWprojekt.dll",
      "args": [],
      "cwd": "${workspaceFolder}/WoWprojekt/WoWprojekt",
      "preLaunchTask": "build-wowprojekt",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "launchBrowser": {
        "enabled": true,
        "args": "http://localhost:5220",
        "windows": {
          "command": "cmd.exe",
          "args": "/C start http://localhost:5220"
        }
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s"
      }
    }
  ]
}
