{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "WoWprojekt (Debug)",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/WoWprojekt/WoWprojekt/WoWprojekt.csproj"
      ],
      "cwd": "${workspaceFolder}/WoWprojekt/WoWprojekt",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5220;https://localhost:7092"
      },
      "stopAtEntry": false,
      "launchBrowser": {
        "enabled": true,
        "args": "http://localhost:5220"
      }
    }
  ]
}
